generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  service     String   // e.g., "Web App", "SEO"
  budget      String?  // Optional range
  message     String   @db.Text
  status      Status   @default(UNREAD)
  createdAt   DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  imageUrl    String
  tags        String[] // Stored as array in Postgres
  liveLink    String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum Status {
  UNREAD
  READ
  CONTACTED
  ARCHIVED
}

model PricingPlan {
  id          String   @id @default(cuid())
  name        String
  price       String
  description String
  features    String[]
  highlighted Boolean  @default(false)
  order       Int      @default(1)
}

model Testimonial {
  id        String   @id @default(cuid())
  client    String
  company   String
  content   String
  avatarUrl String?
  approved  Boolean  @default(true)
}

